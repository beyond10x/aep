{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawProjectConfig",
  "description": "A project configuration document, as parsed.",
  "type": "object",
  "required": [
    "profile",
    "protocol"
  ],
  "properties": {
    "artifacts": {
      "description": "Where the artifact manifest is.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "planning_identity": {
      "description": "An event-log stream identity. Refused: no store this build reads has one.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "planning_scope": {
      "description": "Provider-complete logical scope, required by `aep.project/5`.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "planning_tenant": {
      "description": "An event-log tenant identity. Refused: no store this build reads has one.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "principles": {
      "description": "Where project-local principles are.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "description": "The profile it uses.",
      "allOf": [
        {
          "$ref": "#/definitions/ProfileVersionedRef"
        }
      ]
    },
    "profiles": {
      "description": "Where project-local profiles are.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "description": "The protocol version this project runs under.",
      "allOf": [
        {
          "$ref": "#/definitions/ProtocolRef"
        }
      ]
    },
    "protocols": {
      "description": "A local tree path or a pinned `git+ssh://`, `git+https://`, or `git+file://` repository.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "providers": {
      "description": "A URL pattern per external system, each carrying `{key}`.",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "schemas": {
      "description": "Where project-owned JSON Schema contracts are.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "description": "Where execution state is kept.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "store": {
      "description": "Where the plan is kept. Absent means `git: {}`.\n\nHeld as written and read as a [`RawStore`] only after the version is accepted, so a `/1` document whose selector this build no longer spells still reaches the refusal naming its migration.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/RawStore"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "description": "A one-line description.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "description": "Where the task document is.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "description": "The format version.",
      "default": "aep.project/1",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ProfileVersionedRef": {
      "description": "Reference to a profile, optionally pinned to a major version.",
      "type": "string",
      "maxLength": 219,
      "pattern": "^(profile:)?[a-z][a-z0-9]*(-[a-z0-9]+)*(([./][a-z0-9]+(-[a-z0-9]+)*)*[./]([a-z0-9]*[a-z][a-z0-9]*(-[a-z0-9]+)*|[0-9]+(-[a-z0-9]+)+))?(/[1-9][0-9]*)?$"
    },
    "ProtocolRef": {
      "description": "Reference to a protocol at a major version, such as `aep/1`.",
      "type": "string",
      "maxLength": 220,
      "pattern": "^(protocol:)?[a-z][a-z0-9]*(-[a-z0-9]+)*/[1-9][0-9]*$"
    },
    "RawGit": {
      "description": "The `git` store selector: empty in `aep.project/5`, and any key is refused.",
      "type": "object",
      "additionalProperties": false
    },
    "RawPostgres": {
      "description": "The `postgres` store selector.",
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "description": "A libpq connection string or URL.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RawSqlite": {
      "description": "The `sqlite` store selector.",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "The database file, relative to `.engineering/`.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RawStore": {
      "description": "Where a project keeps its plan, as written in an `aep.project/5` `project.yaml`.\n\n```yaml store: { git: {} }                          # the default: `.engineering/planning/` store: { sqlite: { path: plan.sqlite3 } }   # one file, relative to `.engineering/` store: { postgres: { url: \"postgres://…\" } } ```",
      "anyOf": [
        {
          "description": "A bare word. None is a store in `aep.project/5`; read so the refusal can name the forms.",
          "type": "string"
        },
        {
          "description": "`git: {}`: the Markdown files under `planning` are the authority.",
          "type": "object",
          "required": [
            "git"
          ],
          "properties": {
            "git": {
              "description": "Carries no fields in `aep.project/5`.",
              "allOf": [
                {
                  "$ref": "#/definitions/RawGit"
                }
              ]
            }
          }
        },
        {
          "description": "`sqlite: { path: <path> }`.",
          "type": "object",
          "required": [
            "sqlite"
          ],
          "properties": {
            "sqlite": {
              "description": "Where the database file is.",
              "allOf": [
                {
                  "$ref": "#/definitions/RawSqlite"
                }
              ]
            }
          }
        },
        {
          "description": "`postgres: { url: <url> }`.",
          "type": "object",
          "required": [
            "postgres"
          ],
          "properties": {
            "postgres": {
              "description": "Which database to connect to.",
              "allOf": [
                {
                  "$ref": "#/definitions/RawPostgres"
                }
              ]
            }
          }
        },
        {
          "description": "`eventlog: {…}`, an event-log store selector. Read only so the document reaches its refusal, which names how to migrate it; its contents are not interpreted.",
          "type": "object",
          "required": [
            "eventlog"
          ],
          "properties": {
            "eventlog": {
              "description": "The selector as written."
            }
          }
        }
      ]
    }
  }
}
