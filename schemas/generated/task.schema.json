{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawTask",
  "description": "A task document, as parsed.",
  "type": "object",
  "allOf": [
    {
      "description": "Exactly one of `kind` and `type` is required.",
      "oneOf": [
        {
          "required": [
            "kind"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ]
    },
    {
      "description": "`manifest` and `artifact_manifest` are one field; give one or the other, not both.",
      "not": {
        "required": [
          "artifact_manifest",
          "manifest"
        ]
      }
    },
    {
      "description": "`principle_overrides` and `principles` are one field; give one or the other, not both.",
      "not": {
        "required": [
          "principle_overrides",
          "principles"
        ]
      }
    }
  ],
  "required": [
    "id",
    "objective",
    "profile",
    "protocol"
  ],
  "properties": {
    "artifact_manifest": {
      "description": "An accepted spelling of `manifest`; give one or the other, not both.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "constraints": {
      "description": "Its limits and declared inputs.",
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/Constraints"
        }
      ]
    },
    "context": {
      "description": "Other artifacts that constrain it.",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/Node"
        }
      }
    },
    "derived_from": {
      "description": "What this task was decomposed from.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "id": {
      "description": "Its identifier.",
      "allOf": [
        {
          "$ref": "#/definitions/TaskId"
        }
      ]
    },
    "kind": {
      "description": "What sort of work it is.",
      "allOf": [
        {
          "$ref": "#/definitions/TaskKind"
        }
      ]
    },
    "manifest": {
      "description": "Where the artifact manifest lives.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "description": "What it is for.",
      "allOf": [
        {
          "$ref": "#/definitions/Objective"
        }
      ]
    },
    "principle_overrides": {
      "description": "Principles it adds or drops.",
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/PrincipleOverrides"
        }
      ]
    },
    "principles": {
      "description": "An accepted spelling of `principle_overrides`; give one or the other, not both.",
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/PrincipleOverrides"
        }
      ]
    },
    "profile": {
      "description": "Which profile it uses.",
      "allOf": [
        {
          "$ref": "#/definitions/ProfileVersionedRef"
        }
      ]
    },
    "protocol": {
      "description": "Which protocol version governs it.",
      "allOf": [
        {
          "$ref": "#/definitions/ProtocolRef"
        }
      ]
    },
    "subject": {
      "description": "What it is about — the thing evidence must be observed of.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/SubjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "description": "An accepted spelling of `kind`; give one or the other, not both.",
      "allOf": [
        {
          "$ref": "#/definitions/TaskKind"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ArtifactRef": {
      "description": "Reference to an artifact, optionally pinned with `@<version>`.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*:[A-Za-z0-9][A-Za-z0-9._/-]*(@[^@]+)?$"
    },
    "Capability": {
      "description": "A semantic capability, such as `repository.write`, `network.read:private` or `deployment.create:staging`.",
      "examples": [
        "repository.read",
        "repository.write",
        "tests.execute",
        "command.execute",
        "network.write",
        "telemetry.read",
        "production.read",
        "production.write",
        "secret.read",
        "artifact.read",
        "artifact.write",
        "planning.read",
        "planning.write",
        "review.request",
        "approval.request",
        "network.read",
        "network.read:public",
        "network.read:private",
        "deployment.create:staging",
        "deployment.rollback:production"
      ],
      "type": "string"
    },
    "CapabilityPolicy": {
      "description": "The capabilities an execution may exercise.",
      "type": "object",
      "not": {
        "required": [
          "approval_required",
          "require_approval"
        ]
      },
      "properties": {
        "allow": {
          "description": "Capabilities that may be exercised.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        },
        "approval_required": {
          "description": "Capabilities that may be exercised only with a recorded approval.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        },
        "deny": {
          "description": "Capabilities that must never be exercised.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        },
        "require_approval": {
          "description": "An accepted spelling of `approval_required`; give one or the other, not both.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Constraints": {
      "description": "Limits and inputs that apply to one task.",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capability limits on top of the profile's.",
          "allOf": [
            {
              "$ref": "#/definitions/CapabilityPolicy"
            }
          ]
        },
        "ess_conformance_coverage_v1": {
          "description": "Independently authored complete ESS selection, never populated from report facts.",
          "anyOf": [
            {
              "$ref": "#/definitions/EssConformanceCoverageExpectation"
            },
            {
              "type": "null"
            }
          ]
        },
        "ess_conformance_v2": {
          "description": "Independently authored exact ESS count-stage expectation; never filled from evidence facts.",
          "anyOf": [
            {
              "$ref": "#/definitions/EssConformanceV2Expectation"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "description": "Facts the task declares, which nothing else can observe for it.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/FactValue"
          }
        },
        "notes": {
          "description": "Anything a person needs to know that the protocol does not model.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "EssConformanceCoverageExpectation": {
      "description": "Independently chosen model, original suite and complete declared selection.",
      "type": "object",
      "required": [
        "model",
        "selected_ids",
        "selection",
        "suite"
      ],
      "properties": {
        "model": {
          "$ref": "#/definitions/ArtifactRef"
        },
        "selected_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection": {
          "$ref": "#/definitions/Selection"
        },
        "suite": {
          "$ref": "#/definitions/SuiteReference2"
        }
      },
      "additionalProperties": false
    },
    "EssConformanceV2Expectation": {
      "description": "Independently authored task expectation. A report must never populate this value itself.",
      "type": "object",
      "required": [
        "model",
        "selected_ids",
        "suite"
      ],
      "properties": {
        "model": {
          "$ref": "#/definitions/ArtifactRef"
        },
        "selected_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suite": {
          "$ref": "#/definitions/SuiteReference"
        }
      },
      "additionalProperties": false
    },
    "FactValue": {
      "description": "A fact value: boolean, number or string.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "description": "A number; NaN is not permitted.",
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "Filter": {
      "description": "An unfiltered selection or a precise narrowing of an admitted parent.",
      "oneOf": [
        {
          "description": "No parent or selected-ID filter.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "all"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exact IDs selected from the immediately preceding suite.",
          "type": "object",
          "required": [
            "ids",
            "kind",
            "parent"
          ],
          "properties": {
            "ids": {
              "description": "Sorted distinct requested identities, possibly empty.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "explicit"
              ]
            },
            "parent": {
              "description": "Exact immediate parent.",
              "allOf": [
                {
                  "$ref": "#/definitions/SuiteReference2"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Node": {
      "description": "Any JSON/YAML value: null, boolean, number, string, array or object."
    },
    "Objective": {
      "description": "What the task is for: a one-line statement, or a mapping with `summary` (or `objective`) and longer `details`.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "summary"
              ]
            },
            {
              "required": [
                "objective"
              ]
            }
          ],
          "properties": {
            "details": {
              "type": "string"
            },
            "objective": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Origins": {
      "description": "The origins selected by the independently declared boundary.",
      "type": "string",
      "enum": [
        "authored",
        "generated",
        "generated_and_authored"
      ]
    },
    "PrincipleId": {
      "description": "principle identifier.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "PrincipleOverrides": {
      "description": "Which principles a task adds to or removes from its profile.",
      "type": "object",
      "properties": {
        "add": {
          "description": "Principles to add.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PrincipleRef"
          }
        },
        "remove": {
          "description": "Principles to drop.\n\nRemoval is recorded in the audit trail: dropping `mutation-testing` for one task is a decision someone should be able to find later.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PrincipleId"
          }
        }
      },
      "additionalProperties": false
    },
    "PrincipleRef": {
      "description": "Reference to a principle, optionally pinned to a major version.",
      "type": "string",
      "maxLength": 221,
      "pattern": "^(principle:)?[a-z][a-z0-9]*(-[a-z0-9]+)*(/[1-9][0-9]*)?$"
    },
    "ProfileVersionedRef": {
      "description": "Reference to a profile, optionally pinned to a major version.",
      "type": "string",
      "maxLength": 219,
      "pattern": "^(profile:)?[a-z][a-z0-9]*(-[a-z0-9]+)*(([./][a-z0-9]+(-[a-z0-9]+)*)*[./]([a-z0-9]*[a-z][a-z0-9]*(-[a-z0-9]+)*|[0-9]+(-[a-z0-9]+)+))?(/[1-9][0-9]*)?$"
    },
    "ProtocolRef": {
      "description": "Reference to a protocol at a major version, such as `aep/1`.",
      "type": "string",
      "maxLength": 220,
      "pattern": "^(protocol:)?[a-z][a-z0-9]*(-[a-z0-9]+)*/[1-9][0-9]*$"
    },
    "Scope": {
      "description": "Whole-system or named-component coverage boundary.",
      "oneOf": [
        {
          "description": "The system boundary.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One explicitly named component.",
          "type": "object",
          "required": [
            "component",
            "kind"
          ],
          "properties": {
            "component": {
              "description": "Original component name.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "component"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Selection": {
      "description": "Complete declared selection, never inferred from an execution count.",
      "type": "object",
      "required": [
        "filter",
        "origins",
        "scope"
      ],
      "properties": {
        "filter": {
          "description": "Full parent-bound filter.",
          "allOf": [
            {
              "$ref": "#/definitions/Filter"
            }
          ]
        },
        "origins": {
          "description": "Selected source families.",
          "allOf": [
            {
              "$ref": "#/definitions/Origins"
            }
          ]
        },
        "scope": {
          "description": "System or component boundary.",
          "allOf": [
            {
              "$ref": "#/definitions/Scope"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SubjectRef": {
      "description": "Subject of evidence, written `<kind>:<id>`.",
      "type": "string",
      "maxLength": 401,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*:[A-Za-z0-9]([A-Za-z0-9]|[./_-][A-Za-z0-9])*$"
    },
    "SuiteReference": {
      "description": "Exact original-suite identity; only the frozen count-stage profile is admitted.",
      "type": "object",
      "required": [
        "digest",
        "digest_profile",
        "version"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "digest_profile": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SuiteReference2": {
      "description": "Checked exact suite/5 reference. It does not broaden the frozen count reference.",
      "type": "object",
      "required": [
        "digest",
        "digest_profile",
        "version"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "digest_profile": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TaskId": {
      "description": "task identifier.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9]|[./_-][A-Za-z0-9])*$"
    },
    "TaskKind": {
      "description": "What sort of work the task is.",
      "examples": [
        "feature",
        "bugfix",
        "refactor",
        "investigation",
        "incident",
        "release",
        "migration",
        "dependency-upgrade",
        "security-response",
        "infrastructure-change",
        "documentation"
      ],
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    }
  }
}
