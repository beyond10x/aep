{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "description": "A repository's project file, `.engineering/project.yaml`.",
  "x-ess-name": "aep.plan.Project",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "engineering": {
      "$ref": "#/$defs/aep.plan.EngineeringDirectory"
    },
    "root": {
      "$ref": "#/$defs/aep.plan.ProjectRoot",
      "description": "The directory holding `.engineering/` (crates/edge/aep-project/src/project.rs:94-95).",
      "x-ess-relation": {
        "name": "repository",
        "kind": "references",
        "source": "aep.plan.Project",
        "target": "aep.plan.Repository",
        "cardinality": "one",
        "via": "root"
      }
    },
    "protocol": {
      "description": "The protocol it runs under (project.rs:654-655).",
      "type": "string"
    },
    "profile": {
      "description": "The profile whose rules apply (project.rs:656-657).",
      "type": "string"
    },
    "summary": {
      "description": "A one-line description (project.rs:658-660).",
      "type": "string"
    },
    "protocols": {
      "description": "A local tree path or a pinned `git+…#<40-hex>` locator (project.rs:661-663).",
      "type": "string"
    },
    "artifacts": {
      "description": "Where the artifact manifest is (project.rs:664-666).",
      "type": "string"
    },
    "task": {
      "description": "Where the task document is (project.rs:667-669).",
      "type": "string"
    },
    "state_path": {
      "description": "Where execution state is kept (project.rs:670-672). The file's key is `state`, which ESS refuses as a field's wire name beside a lifecycle (\"wire field \\\"state\\\" is already used at entity aep.plan.Project.lifecycle\").",
      "type": "string"
    },
    "principles": {
      "description": "Where project-local principles are (project.rs:673-675).",
      "type": "string"
    },
    "profiles": {
      "description": "Where project-local profiles are (project.rs:676-678).",
      "type": "string"
    },
    "schemas": {
      "description": "Where project-owned JSON Schema contracts are (project.rs:679-681).",
      "type": "string"
    },
    "store": {
      "$ref": "#/$defs/aep.plan.Store",
      "description": "Where the plan is kept; absent means `git` (project.rs:682-689, 642-644). An `aep.project/1` file's `store: markdown` (migrate_git.rs:171-172) is held as absent."
    },
    "planning_scope": {
      "$ref": "#/$defs/aep.plan.PlanningScope",
      "description": "Required by `aep.project/5` (project.rs:612-626); `aep.project/1` has none (store_command.rs:121). Validated and then not kept: `ProjectConfig` (project.rs:348-377) has no such field."
    },
    "providers": {
      "description": "A URL pattern per external system, each carrying `{key}` (project.rs:699-701).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-ess-map-key": "String"
    },
    "findings_required_since": {
      "$ref": "#/$defs/aep.plan.UtcDate",
      "description": "A UTC date. With it set, whatever the date, `aep plan artifact new review-result` refuses a body with no `findings` block unless `--prose-only <reason>` says why; `aep plan artifact validate` reads the date, and counts as a problem a block-less review-result not created before the start of that date in UTC, an undated one included (see the aep.review domain). Written with no value (empty, `~` or `null`) it is refused naming the key, never read as absent: pinned by `a_findings_required_since_written_empty_or_null_is_refused_naming_the_key` (aep-domain)."
    },
    "spend": {
      "description": "The baseline and target per task kind and figure that `aep plan artifact spend` reports each median against. The verb never writes it: a person copies the medians in. Written with no value, or with a kind holding no figure, it is refused rather than read as absent.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/aep.plan.SpendBound"
        },
        "x-ess-map-key": "String"
      },
      "x-ess-map-key": "String"
    },
    "repeated_transitions": {
      "description": "How many transitions, over every document of the store, are identical in every field to the transition immediately before them in the same document, so that their rendered `transitions` lines are byte-identical. Only an `aep.project/5` store has transitions; `0` for an `aep.project/1` one. A transition that repeats an earlier one that is not immediately before it is not counted.",
      "type": "integer"
    },
    "engineering_clean": {
      "description": "`git status --porcelain -- .` run in `.engineering/` prints nothing (migrate_git.rs `git_clean`).",
      "type": "boolean"
    },
    "planning_is_directory": {
      "description": "`.engineering/planning/` is a directory.",
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/aep.plan.Project.State"
    }
  },
  "required": [
    "engineering",
    "root",
    "protocol",
    "profile",
    "providers",
    "spend",
    "repeated_transitions",
    "engineering_clean",
    "planning_is_directory",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-invariants": [
    "(state != GitNative or defined(planning_scope))"
  ],
  "x-ess-provenance": {
    "system": "aep",
    "specification_version": "v1",
    "source_digest": "be8b331858b6f33709f3c44417df0ad36f99fceec337d7b4201baef5be70bbd6",
    "contract_digest": "slice-sha256/2:fea72d460078eea1b1fb1a94cbdf09ea5b9acaa3bed2a6cddfa46c0031c3d46b",
    "regenerate": "ess generate"
  },
  "$defs": {
    "aep.plan.EngineeringDirectory": {
      "title": "EngineeringDirectory",
      "x-ess-name": "aep.plan.EngineeringDirectory",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.plan.PlanningScope": {
      "title": "PlanningScope",
      "x-ess-name": "aep.plan.PlanningScope",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-invariants": [
        "value.utf8_bytes >= 1",
        "value.utf8_bytes <= 255"
      ]
    },
    "aep.plan.PostgresStore": {
      "title": "PostgresStore",
      "x-ess-name": "aep.plan.PostgresStore",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "url": {
          "description": "A libpq connection string or URL (project.rs:450-451).",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "aep.plan.Project.State": {
      "title": "State",
      "x-ess-name": "aep.plan.Project.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "GitNative",
        "JournalLayout"
      ]
    },
    "aep.plan.ProjectRoot": {
      "title": "ProjectRoot",
      "x-ess-name": "aep.plan.ProjectRoot",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.plan.SpendBound": {
      "title": "SpendBound",
      "x-ess-name": "aep.plan.SpendBound",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "baseline": {
          "description": "The median a person copied from `aep plan artifact spend --baseline <n>`.",
          "type": "integer"
        },
        "target": {
          "description": "The median the project aims for, strictly below the baseline.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "baseline",
        "target"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "target >= 0",
        "target < baseline"
      ]
    },
    "aep.plan.SqliteStore": {
      "title": "SqliteStore",
      "x-ess-name": "aep.plan.SqliteStore",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "path": {
          "description": "The database file, relative to `.engineering/` (project.rs:442-443).",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "aep.plan.Store": {
      "title": "Store",
      "x-ess-name": "aep.plan.Store",
      "x-ess-kind": "union",
      "oneOf": [
        {
          "title": "git",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "git"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "title": "postgres",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "postgres"
            },
            "value": {
              "$ref": "#/$defs/aep.plan.PostgresStore"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "title": "sqlite",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sqlite"
            },
            "value": {
              "$ref": "#/$defs/aep.plan.SqliteStore"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "x-ess-union-tag": "kind"
    },
    "aep.plan.UtcDate": {
      "title": "UtcDate",
      "x-ess-name": "aep.plan.UtcDate",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-invariants": [
        "value.utf8_bytes >= 10",
        "value.utf8_bytes <= 10"
      ]
    }
  }
}
