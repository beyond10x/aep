{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run",
  "description": "A driven run and the counts it keeps of its map's llm steps.",
  "x-ess-name": "aep.drive.Run",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "#/$defs/aep.drive.RunId"
    },
    "map": {
      "$ref": "#/$defs/aep.drive.StepMapId",
      "description": "The step map driving the run (`DriverCursor::map`)."
    },
    "llm_steps_declared": {
      "description": "How many `llm` steps the map declares, over every state (map.rs `StepMap::llm_steps_declared`).",
      "type": "integer"
    },
    "llm_steps_run": {
      "description": "How many `llm` step attempts the run has begun, over its whole life, resumes included: the sum of the cursor's `attempts` at every `llm` step of the map. A step retried once is two, as `steps run` counts it.",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/aep.drive.Run.State"
    }
  },
  "required": [
    "run",
    "map",
    "llm_steps_declared",
    "llm_steps_run",
    "state"
  ],
