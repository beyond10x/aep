{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run",
  "description": "A driven run and the counts it keeps of its map's llm steps.",
  "x-ess-name": "aep.drive.Run",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "#/$defs/aep.drive.RunId"
    },
    "map": {
      "$ref": "#/$defs/aep.drive.StepMapId",
      "description": "The step map driving the run (`DriverCursor::map`)."
    },
    "llm_steps_declared": {
      "description": "How many `llm` steps the map declares, over every state (map.rs `StepMap::llm_steps_declared`).",
      "type": "integer"
    },
    "llm_steps_run": {
      "description": "How many `llm` step attempts the run has begun, over its whole life, resumes included: one per `aep.drive.RunLlmStep`. A step retried once is two, as `steps run` counts it, and an unresolved attempt retried with `--retry-in-flight` is a second attempt although it keeps its attempt number. A cursor written before the count existed starts from the sum of its `attempts` at every `llm` step of the map.",
      "type": "integer"
    },
    "inputs": {
      "description": "The `--input <name>=<value>` pairs the run was started with, by name; a resume reads them back rather than taking new ones.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/aep.drive.RunInput"
      }
    },
    "state": {
      "$ref": "#/$defs/aep.drive.Run.State"
    }
  },
  "required": [
    "run",
    "map",
    "llm_steps_declared",
    "llm_steps_run",
    "inputs",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "aep",
    "specification_version": "v1",
    "source_digest": "e418908b4d756a363f8c7d311d1cf04cf6797f17152b3b74a8b8cb0c756321ef",
    "contract_digest": "slice-sha256/2:b90d944cbc1df9bad3d65adf9144464c993c56bdfe3f57fad54ced53fd07112c",
    "regenerate": "ess generate"
  },
  "$defs": {
    "aep.drive.InputName": {
      "title": "InputName",
      "x-ess-name": "aep.drive.InputName",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "abcdefghijklmnopqrstuvwxyz0123456789_-"
    },
    "aep.drive.Run.State": {
      "title": "State",
      "x-ess-name": "aep.drive.Run.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Started"
      ]
    },
    "aep.drive.RunId": {
      "title": "RunId",
      "x-ess-name": "aep.drive.RunId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.drive.RunInput": {
      "title": "RunInput",
      "x-ess-name": "aep.drive.RunInput",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/aep.drive.InputName"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "aep.drive.StepMapId": {
      "title": "StepMapId",
      "x-ess-name": "aep.drive.StepMapId",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
}
