{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConformanceRecord",
  "description": "A recorded report/2 run against an exact count-stage or ordinary suite.",
  "x-ess-name": "aep.evidence.ConformanceRecord",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "record": {
      "$ref": "#/$defs/aep.evidence.RecordName"
    },
    "artifact": {
      "$ref": "#/$defs/aep.evidence.ArtifactId",
      "description": "The artifact the record is evidence for."
    },
    "suite_version": {
      "description": "The suite's `provenance.suite_version`, equal to the report's `suite.version`; written into the record's source as `suite.version` (planning.rs `recorded_from_report`).",
      "type": "string"
    },
    "suite_kind": {
      "$ref": "#/$defs/aep.evidence.SuiteKind",
      "description": "`count_stage` or `ordinary`: the two kinds this admission records."
    },
    "producer_profile": {
      "$ref": "#/$defs/aep.evidence.ProducerProfile",
      "description": "The report's profile, written into the record's source as `producer_profile` exactly as the report spells it (ess_conformance_v2.rs `facts`)."
    },
    "execution_status": {
      "$ref": "#/$defs/aep.evidence.ExecutionStatus",
      "description": "The report's `execution_status`, once the outcomes above have agreed with it."
    },
    "completed_at": {
      "description": "The report's own `completed_at`, never this process's clock.",
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "$ref": "#/$defs/aep.evidence.ConformanceRecord.State"
    }
  },
  "required": [
    "record",
    "artifact",
    "suite_version",
    "suite_kind",
    "producer_profile",
    "execution_status",
    "completed_at",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "aep",
    "specification_version": "v1",
    "source_digest": "74fecb9e0960b1bf6a1a312b4812f32db2010044acb2f475001ea775d6be714a",
    "contract_digest": "slice-sha256/2:c679856408d998f97894ec7f7451534485b615c5e6cf9317e8102fdf49f4a040",
    "regenerate": "ess generate"
  },
  "$defs": {
    "aep.evidence.ArtifactId": {
      "title": "ArtifactId",
      "x-ess-name": "aep.evidence.ArtifactId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.ConformanceRecord.State": {
      "title": "State",
      "x-ess-name": "aep.evidence.ConformanceRecord.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Recorded"
      ]
    },
    "aep.evidence.ExecutionStatus": {
      "title": "ExecutionStatus",
      "x-ess-name": "aep.evidence.ExecutionStatus",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "aep.evidence.ProducerProfile": {
      "title": "ProducerProfile",
      "x-ess-name": "aep.evidence.ProducerProfile",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "rust_scenario_status_1",
        "go_scenario_status_1",
        "go_scenario_status_2",
        "external_scenario_status_1",
        "unknown"
      ]
    },
    "aep.evidence.RecordName": {
      "title": "RecordName",
      "x-ess-name": "aep.evidence.RecordName",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.SuiteKind": {
      "title": "SuiteKind",
      "x-ess-name": "aep.evidence.SuiteKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "count_stage",
        "ordinary",
        "coverage",
        "unknown"
      ]
    }
  }
}
