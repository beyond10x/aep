{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step",
  "description": "One validated step of an aep.driver-steps/1 or aep.driver-steps/2 map.",
  "x-ess-name": "aep.drive.Step",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "path": {
      "$ref": "#/$defs/aep.drive.StepPath"
    },
    "map": {
      "$ref": "#/$defs/aep.drive.StepMapId",
      "description": "The map the step belongs to."
    },
    "format": {
      "$ref": "#/$defs/aep.drive.StepMapFormat",
      "description": "The format version of the map the step belongs to."
    },
    "kind": {
      "$ref": "#/$defs/aep.drive.StepKind",
      "description": "What sort of step it is."
    },
    "judgement": {
      "description": "What this step decides that no command could, in one line. Present on every `llm` step of a `v2` map, and on an `llm` step of a `v1` map when its author wrote one; a `command` or `operator` step has no such key (`deny_unknown_fields` refuses it).",
      "type": "string"
    },
    "expect": {
      "$ref": "#/$defs/aep.drive.Expectation",
      "description": "Which exit status is the passing verdict. A step that does not write the key holds `success`, and behaves, and digests, exactly as before the key existed. Every `llm` and `operator` step holds `success`: neither has the key (`deny_unknown_fields` refuses it, as for `judgement` on a `command` step)."
    },
    "output": {
      "description": "A file name in the run directory the step's standard output is written to, so a later step names it as `{run_directory}/<file>`. An `llm` or `operator` step has no such key.",
      "type": "string"
    },
    "inputs_named": {
      "description": "The run inputs the step names, each once, in the order it names them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/aep.drive.InputName"
      }
    },
    "state": {
      "$ref": "#/$defs/aep.drive.Step.State"
    }
  },
  "required": [
    "path",
    "map",
    "format",
    "kind",
    "expect",
    "inputs_named",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "aep",
    "specification_version": "v1",
    "source_digest": "d8f2e29903e2887798efd86f43f59241628abffd9b94e056ebacbb0e35934128",
    "contract_digest": "slice-sha256/2:b94d8526b1a1b656f97815869170f856bc66d4324bafca10f42b3630580a8942",
    "regenerate": "ess generate"
  },
  "$defs": {
    "aep.drive.Expectation": {
      "title": "Expectation",
      "x-ess-name": "aep.drive.Expectation",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "aep.drive.InputName": {
      "title": "InputName",
      "x-ess-name": "aep.drive.InputName",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "abcdefghijklmnopqrstuvwxyz0123456789_-"
    },
    "aep.drive.Step.State": {
      "title": "State",
      "x-ess-name": "aep.drive.Step.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Declared"
      ]
    },
    "aep.drive.StepKind": {
      "title": "StepKind",
      "x-ess-name": "aep.drive.StepKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "command",
        "llm",
        "operator"
      ]
    },
    "aep.drive.StepMapFormat": {
      "title": "StepMapFormat",
      "x-ess-name": "aep.drive.StepMapFormat",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "v1",
        "v2"
      ]
    },
    "aep.drive.StepMapId": {
      "title": "StepMapId",
      "x-ess-name": "aep.drive.StepMapId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.drive.StepPath": {
      "title": "StepPath",
      "x-ess-name": "aep.drive.StepPath",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
}
