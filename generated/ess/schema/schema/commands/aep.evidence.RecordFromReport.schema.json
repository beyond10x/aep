    "specification_version": "v1",
    "source_digest": "30dd95d9b314e9696fb0214d54ea273a32c1a6fcea0b83d13d6454cddb0e653a",
    "contract_digest": "slice-sha256/2:35029e44e934b6df5d450d312c21cc58d1023bb392a29e89069870dc33ff6fdc",
    "regenerate": "ess generate"
  },
  "$defs": {
    "aep.evidence.ArtifactId": {
      "title": "ArtifactId",
      "x-ess-name": "aep.evidence.ArtifactId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.RecordName": {
      "title": "RecordName",
      "x-ess-name": "aep.evidence.RecordName",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.SuiteKind": {
      "title": "SuiteKind",
      "x-ess-name": "aep.evidence.SuiteKind",
      "x-ess-kind": "enum",
