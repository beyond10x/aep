{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aep plan artifact evidence --from --suite input",
  "description": "Record a report/2 against the exact suite it ran, bound by version and digest.",
  "x-ess-name": "aep.evidence.RecordFromReport",
  "x-ess-kind": "command-input",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/aep.evidence.ArtifactId"
    },
    "record": {
      "$ref": "#/$defs/aep.evidence.RecordName"
    },
    "suite_version": {
      "description": "The suite's `provenance.suite_version`, as written.",
      "type": "string"
    },
    "report_suite_version": {
      "description": "The report's `suite.version`, as written.",
      "type": "string"
    },
    "suite_kind": {
      "$ref": "#/$defs/aep.evidence.SuiteKind"
    },
    "report_suite_kind": {
      "$ref": "#/$defs/aep.evidence.SuiteKind"
    },
    "suite_digest_matches": {
      "type": "boolean"
    },
    "producer_profile": {
      "$ref": "#/$defs/aep.evidence.ProducerProfile"
    },
    "execution_status": {
      "$ref": "#/$defs/aep.evidence.ExecutionStatus",
      "description": "The report's `execution_status`, as written."
    },
    "failed": {
      "type": "integer"
    },
    "error": {
      "type": "integer"
    },
    "unsupported": {
      "type": "integer"
    },
    "skipped": {
      "type": "integer"
    },
    "report_input_form": {
      "$ref": "#/$defs/aep.evidence.InputForm"
    },
    "suite_input_form": {
      "$ref": "#/$defs/aep.evidence.InputForm"
    },
    "report_input": {
      "type": "string"
    },
    "suite_input": {
      "type": "string"
    },
    "report_input_digest": {
      "$ref": "#/$defs/aep.evidence.InputDigest"
    },
    "suite_input_digest": {
      "$ref": "#/$defs/aep.evidence.InputDigest"
    },
    "reference": {
      "description": "`report_input`@`report_input_digest`, as aep.evidence.ConformanceRecord says.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "record",
    "suite_version",
    "report_suite_version",
    "suite_kind",
    "report_suite_kind",
    "suite_digest_matches",
    "producer_profile",
    "execution_status",
    "failed",
    "error",
    "unsupported",
    "skipped",
    "report_input_form",
    "suite_input_form",
    "report_input",
    "suite_input",
    "report_input_digest",
    "suite_input_digest",
    "reference"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "aep",
    "specification_version": "v1",
    "source_digest": "d8f2e29903e2887798efd86f43f59241628abffd9b94e056ebacbb0e35934128",
    "contract_digest": "slice-sha256/2:d2122ef4b1074a62a092cb2da0d9257637de1700624ca5ee0e9be9b6e931bf6b",
    "regenerate": "ess generate"
  },
  "$defs": {
    "aep.evidence.ArtifactId": {
      "title": "ArtifactId",
      "x-ess-name": "aep.evidence.ArtifactId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.ExecutionStatus": {
      "title": "ExecutionStatus",
      "x-ess-name": "aep.evidence.ExecutionStatus",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "aep.evidence.InputDigest": {
      "title": "InputDigest",
      "x-ess-name": "aep.evidence.InputDigest",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.InputForm": {
      "title": "InputForm",
      "x-ess-name": "aep.evidence.InputForm",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "repository_relative",
        "file_name",
        "as_typed"
      ]
    },
    "aep.evidence.ProducerProfile": {
      "title": "ProducerProfile",
      "x-ess-name": "aep.evidence.ProducerProfile",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "rust_scenario_status_1",
        "go_scenario_status_1",
        "go_scenario_status_2",
        "external_scenario_status_1",
        "unknown"
      ]
    },
    "aep.evidence.RecordName": {
      "title": "RecordName",
      "x-ess-name": "aep.evidence.RecordName",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "aep.evidence.SuiteKind": {
      "title": "SuiteKind",
      "x-ess-name": "aep.evidence.SuiteKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "count_stage",
        "ordinary",
        "coverage",
        "unknown"
      ]
    }
  }
}
