    "aep.plan.SpendBound": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "description": "The median a person copied from `aep plan artifact spend --baseline <n>`.",
          "type": "integer"
        },
        "target": {
          "description": "The median the project aims for, strictly below the baseline.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "target"
      ],
      "title": "SpendBound",
      "type": "object",
      "x-ess-invariants": [
        "target >= 0",
        "target < baseline"
      ],
      "x-ess-kind": "struct",
      "x-ess-name": "aep.plan.SpendBound"
    },
    "aep.plan.SpendBoundWritten": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "minimum": 0,
          "type": "integer"
