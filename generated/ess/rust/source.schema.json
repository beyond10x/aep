      },
      "required": [
        "baseline",
        "target"
      ],
      "title": "SpendBoundWritten",
      "type": "object",
      "x-ess-invariants": [
        "baseline >= 0",
        "target >= 0"
      ],
      "x-ess-kind": "struct",
      "x-ess-name": "aep.plan.SpendBoundWritten"
