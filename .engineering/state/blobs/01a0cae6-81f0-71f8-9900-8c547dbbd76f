["er.eventlog.import-anchor/1",{"authority":{"logical_scope":"aep","stream_identity":"01a0cae6-7e88-710c-8913-d70d29cb7b4c","tenant":"planning"},"completeness":"available_evidence_only","evidence":[],"instance":{"entity":"aep.entity","fields":{"document":{"events":[],"fields":{"$aep":{"archived":false,"metadata":{"created_at":0,"id":"MIG155bc3b1cf42ccea494bc4ae604428d70e14eb52f6533b5611df27c7843e403b","locator":"ep://planning/store/story/eval-run-caps-the-run","provenance":{"created_by":"system","updated_by":"system"},"revision":4,"type":"aep.story/v1","updated_at":0}},"body":"# Story: `aep eval run --budget-usd` is the session's own ceiling\n\n## Outcome\n\nThe cap a sweep is launched under stops a run while it runs, instead of being compared against the bill afterwards.\n\n## Context\n\n`--budget-usd` was checked before each spawn against the assumed per-run cost and nowhere else. The golden-path case stated $10.96 against `--budget-usd 5` on 2026-09-03 and the only thing the number did was appear in the report's cost row. Claude Code has `--max-budget-usd` for print mode, which is the mode metaharness launches; metaharness 0.6.1 adds `run claude --max-budget-usd` and passes it through.\n\n## Acceptance\n\n- Each spawned Claude run receives `--max-budget-usd <what is left of the cap>` on its metaharness argv, computed from the cap and what earlier runs in the sweep charged.\n- The flag is Claude Code only; codex and b10x argvs are unchanged (metaharness refuses the option for codex by name).\n- A run the vendor stops on budget ends with a terminal record the checker reads as not completed; nothing here turns that into a pass.\n","owner":"eval","relations":[{"decomposes":"epic:self-evaluation"},{"serves":"vision:O3"}],"status":"implemented","summary":"Pass what is left of the cap to each Claude run as metaharness run claude --max-budget-usd; the between-runs check stays.","tags":["bench","eval"],"title":"aep eval run --budget-usd is the session's own ceiling"},"lifecycle_state":"implemented"}},"id":"MIG155bc3b1cf42ccea494bc4ae604428d70e14eb52f6533b5611df27c7843e403b","lifecycle_state":"recorded","revision":4,"version":1},"order":"per_kind_only","subject":["aep.entity","MIG155bc3b1cf42ccea494bc4ae604428d70e14eb52f6533b5611df27c7843e403b"]}]