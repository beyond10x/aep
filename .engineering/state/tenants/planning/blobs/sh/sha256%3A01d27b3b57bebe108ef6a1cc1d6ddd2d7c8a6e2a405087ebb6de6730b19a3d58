ence.","tags":["eval","plugin"],"title":"Every shipped workflow is mapped to the plugin surface that teaches it, or carries a named gap"},"lifecycle_state":"implemented"},"owner":"eval","relations":[{"decomposes":"epic:self-evaluation"}],"summary":"The join between workflows/ and integrations/ becomes a checked document, so a workflow nothing teaches is a row a reader can find rather than a silence.","tags":["eval","plugin"],"title":"Every shipped workflow is mapped to the plugin surface that teaches it, or carries a named gap"},"id":"ent-0cff86206772066eb59ea0aeea566b51","lifecycle_state":"implemented","revision":1,"version":1},"order":"per_kind_only","subject":["story","ent-0cff86206772066eb59ea0aeea566b51"]}]