ns startup output"},"id":"ent-ebd4bd4c02889fec6a1db815127f4941","lifecycle_state":"implemented","revision":7,"version":1},"order":"per_kind_only","subject":["story","ent-ebd4bd4c02889fec6a1db815127f4941"]}]